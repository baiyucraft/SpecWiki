          "content": "{\"snippets\":[{\"content\":\"public final class FrameworkTypes {\\n  // TODO(erichang): Add the Jakarta Provider here\\n  private static final ImmutableSet<XClassName> PROVISION_TYPES =\\n      ImmutableSet.<XClassName>builder()\\n          .addAll(providerTypeNames())\\n          .add(XTypeNames.LAZY)\\n          .add(XTypeNames.MEMBERS_INJECTOR)\\n          .build();\\n\\n  // NOTE(beder): ListenableFuture is not considered a producer framework type because it is not\\n  // defined by the framework, so we can't treat it specially in ordinary Dagger.\\n  private static final ImmutableSet<XClassName> PRODUCTION_TYPES =\\n      ImmutableSet.of(XTypeNames.PRODUCED, XTypeNames.PRODUCER);\\n\\n  private static final ImmutableSet<XClassName> ALL_FRAMEWORK_TYPES =\\n      ImmutableSet.<XClassName>builder().addAll(PROVISION_TYPES).addAll(PRODUCTION_TYPES).build();\\n\\n  public static final ImmutableSet<XClassName> SET_VALUE_FRAMEWORK_TYPES =\\n      ImmutableSet.of(XTypeNames.PRODUCED);\\n\\n  public static final ImmutableSet<XClassName> MAP_VALUE_FRAMEWORK_TYPES =\\n      ImmutableSet.<XClassName>builder()\\n          .add(XTypeNames.PROVIDER_OF_LAZY)\\n          .add(XTypeNames.LAZY)\",\"end_line\":56,\"path\":\"dagger-compiler/main/java/dagger/internal/codegen/base/FrameworkTypes.java\",\"score\":2,\"snippet_id\":\"snippet-52e8fe4ec9e7\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-9f547e70abbf\",\"start_line\":33,\"symbol_ids\":[]},{\"content\":\"public final class XExecutableTypes {\\n\\n  // TODO(b/271177465): Remove this method once XProcessing supports this feature.\\n  public static boolean isSubsignature(XExecutableElement method1, XExecutableElement method2) {\\n    XProcessingEnv processingEnv = getProcessingEnv(method1);\\n    switch (processingEnv.getBackend()) {\\n      case JAVAC:\\n        return isSubsignatureJavac(method1, method2, processingEnv);\\n      case KSP:\\n        return isSubsignatureKsp(method1, method2);\\n    }\\n    throw new AssertionError(\\\"Unexpected backend: \\\" + processingEnv.getBackend());\\n  }\\n\\n  private static boolean isSubsignatureKsp(XExecutableElement method1, XExecutableElement method2) {\\n    if (method1.getParameters().size() != method2.getParameters().size()) {\\n      return false;\\n    }\\n    ImmutableList<TypeName> method1Parameters = getParameters(method1);\\n    ImmutableList<TypeName> method1TypeParameters = getTypeParameters(method1);\\n    ImmutableList<TypeName> method2TypeParameters = getTypeParameters(method2);\\n    return (method1TypeParameters.equals(method2TypeParameters)\\n            && method1Parameters.equals(getParameters(method2)))\\n        || (method1TypeParameters\",\"end_line\":59,\"path\":\"dagger-compiler/main/java/dagger/internal/codegen/xprocessing/XExecutableTypes.java\",\"score\":2,\"snippet_id\":\"snippet-ca9258face46\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-9c5482c85436\",\"start_line\":36,\"symbol_ids\":[]},{\"content\":\"public final class XTypes {\\n  private static class XTypeEquivalence extends Equivalence<XType> {\\n    private final boolean ignoreVariance;\\n\\n    XTypeEquivalence(boolean ignoreVariance) {\\n      this.ignoreVariance = ignoreVariance;\\n    }\\n\\n    @Override\\n    protected boolean doEquivalent(XType left, XType right) {\\n      return getTypeName(left).equals(getTypeName(right));\\n    }\\n\\n    @Override\\n    protected int doHash(XType type) {\\n      return getTypeName(type).hashCode();\\n    }\\n\\n    @Override\\n    public String toString() {\\n      return \\\"XTypes.equivalence()\\\";\\n    }\\n\\n    private TypeName getTypeName(XType type) {\",\"end_line\":92,\"path\":\"dagger-compiler/main/java/dagger/internal/codegen/xprocessing/XTypes.java\",\"score\":2,\"snippet_id\":\"snippet-0313dea9f9d5\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-787ddd142b93\",\"start_line\":69,\"symbol_ids\":[]},{\"content\":\"public final class XTypeSpecs {\\n  public static Builder classBuilder(String name) {\\n    return new Builder(Builder.Kind.CLASS).name(name);\\n  }\\n\\n  public static Builder classBuilder(XClassName className) {\\n    return classBuilder(className.getSimpleName());\\n  }\\n\\n  public static Builder interfaceBuilder(String name) {\\n    return new Builder(Builder.Kind.INTERFACE).name(name);\\n  }\\n\\n  public static Builder interfaceBuilder(XClassName className) {\\n    return interfaceBuilder(className.getSimpleName());\\n  }\\n\\n  public static Builder objectBuilder(String name) {\\n    return new Builder(Builder.Kind.OBJECT).name(name);\\n  }\\n\\n  public static Builder objectBuilder(XClassName className) {\\n    return objectBuilder(className.getSimpleName());\\n  }\",\"end_line\":68,\"path\":\"dagger-compiler/main/java/dagger/internal/codegen/xprocessing/XTypeSpecs.java\",\"score\":2,\"snippet_id\":\"snippet-99d8b4242a89\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-5cfccbd2b881\",\"start_line\":45,\"symbol_ids\":[]},{\"content\":\"@RunWith(JUnit4.class)\\npublic final class AssistedFactoryWithArrayTypesTest {\\n  @Component\\n  interface TestComponent {\\n    FooFactory fooFactory();\\n  }\\n\\n  @AssistedFactory\\n  interface FooFactory {\\n    Foo create(Dep[] depArray);\\n  }\\n\\n  static class Dep {}\\n\\n  static class Foo {\\n    private final Dep[] depArray;\\n\\n    @AssistedInject\\n    Foo(@Assisted Dep[] depArray) {\\n      this.depArray = depArray;\\n    }\\n  }\\n\\n  @Test\",\"end_line\":52,\"path\":\"javatests/dagger/functional/assisted/AssistedFactoryWithArrayTypesTest.java\",\"score\":2,\"snippet_id\":\"snippet-8485aadf1d97\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-fdf80c157d3d\",\"start_line\":29,\"symbol_ids\":[]},{\"content\":\"@RunWith(JUnit4.class)\\npublic final class AssistedFactoryWithQualifiedTypesTest {\\n  @Component\\n  interface TestComponent {\\n    // Test a factory with duplicate types with unique qualifiers.\\n    DupeTypeFactory dupeTypeFactory();\\n\\n    // Test a factory with duplicate qualifiers with unique types.\\n    DupeQualifierFactory dupeQualifierFactory();\\n\\n    // Test a factory with unnecessary qualifiers on the factory.\\n    UnnecessaryQualifierFactory unnecessaryQualifierFactory();\\n\\n    // Test a factory with different parameter order than the constructor.\\n    SwappedDupeTypeFactory swappedDupeTypeFactory();\\n  }\\n\\n  static class DupeType {\\n    private final String str1;\\n    private final String str2;\\n\\n    @AssistedInject\\n    DupeType(@Assisted(\\\"1\\\") String str1, @Assisted(\\\"2\\\") String str2) {\\n      this.str1 = str1;\",\"end_line\":53,\"path\":\"javatests/dagger/functional/assisted/AssistedFactoryWithQualifiedTypesTest.java\",\"score\":2,\"snippet_id\":\"snippet-5ae9a99c7c16\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-2d7e1e06cb7c\",\"start_line\":30,\"symbol_ids\":[]},{\"content\":\"class A {\\n  @Inject A() {}\\n}\",\"end_line\":23,\"path\":\"javatests/dagger/functional/generictypes/A.java\",\"score\":2,\"snippet_id\":\"snippet-c550e06a0884\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-037425d4ef6b\",\"start_line\":21,\"symbol_ids\":[]},{\"content\":\"class B {\\n  @Inject B() {}\\n}\",\"end_line\":23,\"path\":\"javatests/dagger/functional/generictypes/B.java\",\"score\":2,\"snippet_id\":\"snippet-ce3a8cf9b092\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-fdda9a6394b9\",\"start_line\":21,\"symbol_ids\":[]}]}",
