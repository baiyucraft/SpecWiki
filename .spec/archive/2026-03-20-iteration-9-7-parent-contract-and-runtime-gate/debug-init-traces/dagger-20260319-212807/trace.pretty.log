gStep> processingStep;\\n\\n    private KspProcessor(\\n        SymbolProcessorEnvironment symbolProcessorEnvironment,\\n        Function<XProcessingEnv, BaseProcessingStep> processingStep) {\\n      super(symbolProcessorEnvironment);\\n      this.processingStep = processingStep;\",\"end_line\":55,\"path\":\"hilt-testing/main/java/dagger/hilt/android/testing/compile/HiltCompilerProcessors.java\",\"score\":2,\"snippet_id\":\"snippet-b50913e539e6\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-fb6369706b9a\",\"start_line\":32,\"symbol_ids\":[]},{\"content\":\"public final class HiltCompilerTests {\\n  private static final ImmutableList<String> DEFAULT_JAVAC_OPTIONS = ImmutableList.of();\\n\\n  private static final ImmutableList<String> DEFAULT_KOTLINC_OPTIONS =\\n      ImmutableList.of(\\n          \\\"-jvm-target=11\\\",\\n          \\\"-jvm-default=no-compatibility\\\",\\n          \\\"-P\\\",\\n          \\\"plugin:org.jetbrains.kotlin.kapt3:correctErrorTypes=true\\\");\\n\\n  /** Returns the {@link XProcessingEnv.Backend} for the given {@link CompilationResultSubject}. */\\n  public static XProcessingEnv.Backend backend(CompilationResultSubject subject) {\\n    return CompilerTests.backend(subject);\\n  }\\n\\n  /** Returns a {@link Source.KotlinSource} with the given file name and content. */\\n  public static Source.KotlinSource kotlinSource(\\n      String fileName, ImmutableCollection<String> srcLines) {\\n    return CompilerTests.kotlinSource(fileName, srcLines);\\n  }\\n\\n  /** Returns a {@link Source.KotlinSource} with the given file name and content. */\\n  public static Source.KotlinSource kotlinSource(String fileName, String... srcLines) {\\n    return CompilerTests.kotlinSource(fileName, srcLines);\",\"end_line\":96,\"path\":\"hilt-testing/main/java/dagger/hilt/android/testing/compile/HiltCompilerTests.java\",\"score\":2,\"snippet_id\":\"snippet-3e6c0107ef74\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-eb4bf837e21f\",\"star