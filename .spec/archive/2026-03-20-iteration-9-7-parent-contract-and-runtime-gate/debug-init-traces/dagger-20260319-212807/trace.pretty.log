          "content": "{\"snippets\":[{\"content\":\"public final class dagger/grpc/server/CurrentContextModule {\\n\\tpublic fun <init> ()V\\n}\\n\\npublic final class dagger/grpc/server/CurrentContextModule_CurrentContextFactory : dagger/internal/Factory {\\n\\tpublic fun <init> ()V\\n\\tpublic static fun create ()Ldagger/grpc/server/CurrentContextModule_CurrentContextFactory;\\n\\tpublic static fun currentContext ()Lio/grpc/Context;\\n\\tpublic fun get ()Lio/grpc/Context;\\n\\tpublic synthetic fun get ()Ljava/lang/Object;\\n}\\n\\npublic final class dagger/grpc/server/GrpcCallMetadataModule {\\n\\tpublic fun <init> (Lio/grpc/Metadata;)V\\n}\\n\\npublic final class dagger/grpc/server/GrpcCallMetadataModule_ProvideHeadersFactory : dagger/internal/Factory {\\n\\tpublic static fun create (Ldagger/grpc/server/GrpcCallMetadataModule;)Ldagger/grpc/server/GrpcCallMetadataModule_ProvideHeadersFactory;\\n\\tpublic fun get ()Lio/grpc/Metadata;\\n\\tpublic synthetic fun get ()Ljava/lang/Object;\\n\\tpublic static fun provideHeaders (Ldagger/grpc/server/GrpcCallMetadataModule;)Lio/grpc/Metadata;\\n}\\n\\npublic final class dagger/grpc/server/InProcessServerModule {\",\"end_line\":24,\"path\":\"dagger-grpc-server/api/dagger-grpc-server.api\",\"score\":1,\"snippet_id\":\"snippet-02e973728cae\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-d074d9927b80\",\"start_line\":1,\"symbol_ids\":[]},{\"content\":\"@Module\\npublic final class CurrentContextModule {\\n\\n  @Provides\\n  static Context currentContext() {\\n    return Context.current();\\n  }\\n}\",\"end_line\":33,\"path\":\"dagger-grpc-server/main/java/dagger/grpc/server/CurrentContextModule.java\",\"score\":2,\"snippet_id\":\"snippet-e7998a06abc7\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-ecb39f7c0ee3\",\"start_line\":26,\"symbol_ids\":[]},{\"content\":\"@Module\\npublic final class GrpcCallMetadataModule {\\n  private final Metadata metadata;\\n\\n  public GrpcCallMetadataModule(Metadata metadata) {\\n    this.metadata = checkNotNull(metadata);\\n  }\\n\\n  @Provides\\n  Metadata provideHeaders() {\\n    return metadata;\\n  }\\n}\",\"end_line\":40,\"path\":\"dagger-grpc-server/main/java/dagger/grpc/server/GrpcCallMetadataModule.java\",\"score\":2,\"snippet_id\":\"snippet-401ff57c9505\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-76c52a306beb\",\"start_line\":28,\"symbol_ids\":[]},{\"content\":\"@Module(includes = ServerModule.class)\\npublic final class InProcessServerModule {\\n\\n  private final String name;\\n\\n  private InProcessServerModule(String name) {\\n    this.name = checkNotNull(name);\\n  }\\n\\n  /**\\n   * Creates a module that provides a server that binds to a given name\\n   *\\n   * @param name the identity of the server for clients to connect to\\n   */\\n  public static InProcessServerModule serverNamed(String name) {\\n    return new InProcessServerModule(name);\\n  }\\n\\n  @Provides\\n  ServerBuilder<?> serverBuilder() {\\n    return InProcessServerBuilder.forName(name);\\n  }\\n}\",\"end_line\":54,\"path\":\"dagger-grpc-server/main/java/dagger/grpc/server/InProcessServerModule.java\",\"score\":2,\"snippet_id\":\"snippet-301150940a6a\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-d3b267370852\",\"start_line\":32,\"symbol_ids\":[]},{\"content\":\"@Module(includes = ServerModule.class)\\npublic final class NettyServerModule {\\n\\n  private final SocketAddress socketAddress;\\n\\n  private NettyServerModule(SocketAddress socketAddress) {\\n    this.socketAddress = socketAddress;\\n  }\\n\\n  /**\\n   * A module that binds to {@code port} on the wildcard address.\\n   */\\n  public static NettyServerModule bindingToPort(int port) {\\n    return new NettyServerModule(new InetSocketAddress(port));\\n  }\\n\\n  /**\\n   * A module that binds to {@code socketAddress}.\\n   */\\n  public static NettyServerModule bindingTo(SocketAddress socketAddress) {\\n    return new NettyServerModule(socketAddress);\\n  }\\n\\n  @Provides\",\"end_line\":55,\"path\":\"dagger-grpc-server/main/java/dagger/grpc/server/NettyServerModule.java\",\"score\":2,\"snippet_id\":\"snippet-6634c40380d1\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-b61e1fa42992\",\"start_line\":32,\"symbol_ids\":[]},{\"content\":\"# A framework supporting Dagger-injected gRPC servers.\\n\\nload(\\\"@rules_java//java:defs.bzl\\\", \\\"java_library\\\")\\nload(\\\"//:build_defs.bzl\\\", \\\"POM_VERSION\\\")\\nload(\\\"//tools/maven:maven.bzl\\\", \\\"gen_maven_artifact\\\")\\n\\npackage(default_visibility = [\\\"//:src\\\"])\\n\\njava_library(\\n    name = \\\"artifact-lib\\\",\\n    tags = [\\\"maven_coordinates=com.google.dagger:dagger-grpc-server:\\\" + POM_VERSION],\\n    exports = [\\n        \\\"//dagger-grpc-server/main/java/dagger/grpc/server\\\",\\n    ],\\n)\\n\\ngen_maven_artifact(\\n    name = \\\"artifact\\\",\\n    artifact_coordinates = \\\"com.google.dagger:dagger-grpc-server:\\\" + POM_VERSION,\\n    artifact_name = \\\"Dagger gRPC Server\\\",\\n    artifact_target = \\\":artifact-lib\\\",\\n    artifact_target_libs = [\\n        \\\"//dagger-grpc-server/main/java/dagger/grpc/server\\\",\\n    ],\",\"end_line\":24,\"path\":\"dagger-grpc-server/BUILD\",\"score\":1,\"snippet_id\":\"snippet-ba2e51cfaf59\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-e071859ccce0\",\"start_line\":1,\"symbol_ids\":[]},{\"content\":\"import dagger.gradle.build.SoftwareType\\nimport dagger.gradle.build.findXProcessingJar\\n\\nplugins {\\n  alias(libs.plugins.daggerBuild)\\n  id(libs.plugins.kotlinJvm.get().pluginId)\\n  id(libs.plugins.binaryCompatibilityValidator.get().pluginId)\\n}\\n\\ndependencies {\\n  api(project(\\\":dagger\\\"))\\n  api(project(\\\":dagger-grpc-server-annotations\\\"))\\n  api(libs.javax.inject)\\n  implementation(libs.guava.failureAccess)\\n  implementation(libs.guava.jre)\\n  implementation(libs.protobuf.java)\\n  implementation(libs.grpc.context)\\n  implementation(libs.grpc.core)\\n  implementation(libs.grpc.netty)\\n  implementation(libs.grpc.protobuf)\\n\\n  annotationProcessor(project(\\\":dagger-compiler\\\", \\\"unshaded\\\"))\\n  annotationProcessor(libs.auto.common)\\n  annotationProcessor(files(project.findXProcessingJar()))\",\"end_line\":24,\"path\":\"dagger-grpc-server/build.gradle.kts\",\"score\":1,\"snippet_id\":\"snippet-d71779a27f86\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-22ead375b6b8\",\"start_line\":1,\"symbol_ids\":[]},{\"content\":\"# A framework supporting Dagger-injected gRPC servers.\\n\\nload(\\\"@rules_java//java:defs.bzl\\\", \\\"java_library\\\")\\nload(\\n    \\\"//:build_defs.bzl\\\",\\n    \\\"DOCLINT_HTML_AND_SYNTAX\\\",\\n    \\\"DOCLINT_REFERENCES\\\",\\n    \\\"JAVA_RELEASE_MIN\\\",\\n)\\n\\npackage(default_visibility = [\\\"//:src\\\"])\\n\\n# TODO(dpb): Split out the grpc:inprocess and grpc:netty deps into separate libraries.\\njava_library(\\n    name = \\\"server\\\",\\n    srcs = glob([\\\"*.java\\\"]),\\n    exported_plugins = [\\n        \\\"//dagger-grpc-server-processor:plugin\\\",\\n    ],\\n    javacopts = DOCLINT_HTML_AND_SYNTAX + DOCLINT_REFERENCES + JAVA_RELEASE_MIN,\\n    exports = [\\\"//dagger-grpc-server-annotations:artifact-lib\\\"],\\n    deps = [\\n        \\\"//third_party/java/auto:value\\\",\\n        \\\"//third_party/java/dagger\\\",\",\"end_line\":24,\"path\":\"dagger-grpc-server/main/java/dagger/grpc/server/BUILD\",\"score\":1,\"snippet_id\":\"snippet-5131f7d7f6ad\",\"snippet_kind\":\"topic-evidence\",\"source_id\":\"source-96bf82eaab50\",\"start_line\":1,\"symbol_ids\":[]}]}",
