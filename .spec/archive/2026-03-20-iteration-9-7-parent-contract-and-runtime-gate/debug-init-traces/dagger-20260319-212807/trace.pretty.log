up\": {\n        \"items\": {\n          \"properties\": {\n            \"diagram_key\": {\n              \"type\": \"string\"\n            },\n            \"diagram_type\": {\n              \"type\": \"string\"\n            },\n            \"summary\": {\n              \"type\": \"string\"\n            },\n            \"title\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"diagram_key\",\n            \"diagram_type\",\n            \"title\",\n            \"summary\"\n          ],\n          \"type\": \"object\"\n        },\n        \"type\": \"array\"\n      },\n      \"evidence_rollup\": {\n        \"items\": {\n          \"properties\": {\n            \"group_key\": {\n              \"type\": \"string\"\n            },\n            \"items\": {\n              \"items\": {\n                \"properties\": {\n                  \"coarse_span\": {\n                    \"type\": \"boolean\"\n                  },\n                  \"end_line\": {\n                    \"type\": \"integer\"\n                  },\n                  \"evidence_type\": {\n                    \"type\": \"string\"\n                  },\n                  \"note\": {\n                    \"type\": \"string\"\n                  },\n                  \"path\": {\n                    \"type\": \"string\"\n                  },\n                  \"section_refs\": {\n                    \"items\": {\n                      \"type\": \"string\"\n                    },\n                    \"type\": \"array\"\n                  },\n                  \"source_id\": {\n                    \"type\": \"string\"\n                  },\n                  \"start_line\": {\n                    \"type\": \"integer\"\n                  }\n                },\n                \"required\": [\n                  \"path\",\n                  \"start_line\",\n                  \"end_line\",\n                  \"evidence_type\",\n                  \"section_refs\",\n                  \"note\",\n                  \"coarse_span\"\n                ],\n                \"type\": \"object\"\n              },\n              \"type\": \"array\"\n            },\n            \"title\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"group_key\",\n            \"title\",\n            \"items\"\n          ],\n          \"type\": \"object\"\n        },\n        \"type\": \"array\"\n      },\n      \"open_questions\": {\n        \"items\": {\n          \"type\": \"string\"\n        },\n        \"type\": \"array\"\n      },\n      \"page_positioning\": {\n        \"type\": \"string\"\n      },\n      \"section_plan\": {\n        \"items\": {\n          \"properties\": {\n            \"child_refs\": {\n              \"items\": {\n                \"type\": \"string\"\n              },\n              \"type\": \"array\"\n            },\n            \"diagram_refs\": {\n              \"items\": {\n                \"type\": \"string\"\n              },\n              \"type\": \"array\"\n            },\n            \"evidence_refs\": {\n              \"items\": {\n                \"type\": \"string\"\n              },\n              \"type\": \"array\"\n            },\n            \"section_key\": {\n              \"type\": \"string\"\n            },\n            \"section_summary\": {\n              \"type\": \"string\"\n            },\n            \"section_title\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"section_key\",\n            \"section_title\",\n            \"section_summary\",\n            \"evidence_refs\",\n            \"diagram_refs\",\n            \"child_refs\"\n          ],\n          \"type\": \"object\"\n        },\n        \"type\": \"array\"\n      },\n      \"summary\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"summary\",\n      \"page_positioning\",\