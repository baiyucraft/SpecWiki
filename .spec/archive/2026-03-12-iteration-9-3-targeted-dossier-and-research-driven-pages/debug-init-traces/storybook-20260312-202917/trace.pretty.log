              "content": "resolveId(source) {\n      if (SB_VIRTUAL_FILE_IDS.includes(source)) {\n        return getResolvedVirtualModuleId(source);\n      }\n      if (source === iframePath) {\n        return iframeId;\n      }\n\n      return undefined;\n    },",
