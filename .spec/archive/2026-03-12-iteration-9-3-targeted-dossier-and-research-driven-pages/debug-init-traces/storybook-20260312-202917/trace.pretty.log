ameters。\",\n      \"targeted_snippets\": [\n        {\n          \"content\": \"export const getVersionSpecifier = (addon: string) => {\\n  const groups = /^(@{0,1}[^@]+)(?:@(.+))?$/.exec(addon);\\n  if (groups) {\\n    return [groups[1], groups[2]] as const;\\n  }\\n  return [addon, undefined] as const;\\n};\",\n          \"end_line\": 45,\n          \"path\": \"code/lib/cli-storybook/src/add.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-5c7248e142de\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-bc9ed46ce99e\",\n          \"start_line\": 39,\n          \"symbol_ids\": [\n            \"symbol-bf574c1bf095\"\n          ]\n        },\n        {\n          \"content\": \"const checkInstalled = (addonName: string, main: StorybookConfigRaw) => {\\n  const existingAddon = main.addons?.find((entry: string | { name: string }) => {\\n    const name = typeof entry === 'string' ? entry : entry.name;\\n    return name?.endsWith(addonName);\\n  });\\n  return !!existingAddon;\\n};\",\n          \"end_line\": 53,\n          \"path\": \"code/lib/cli-storybook/src/add.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-a3403e4e9700\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-bc9ed46ce99e\",\n          \"start_line\": 47,\n          \"symbol_ids\": [\n            \"symbol-bc21d79851f7\"\n          ]\n        },\n        {\n          \"content\": \"const isCoreAddon = (addonName: string) => Object.hasOwn(versions, addonName);\",\n          \"end_line\": 55,\n          \"path\": \"code/lib/cli-storybook/src/add.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-1f3cc6550d15\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-bc9ed46ce99e\",\n          \"start_line\": 55,\n          \"symbol_ids\": [\n            \"symbol-2eacadaab3c3\"\n          ]\n        },\n        {\n          \"content\": \"function isValidVersion(version: string) {\\n  return SemVer.valid(version) || version.match(/^\\\\d+$/);\\n}\",\n          \"end_line\": 189,\n          \"path\": \"code/lib/cli-storybook/src/add.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-3f81726c88c2\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-bc9ed46ce99e\",\n          \"start_line\": 187,\n          \"symbol_ids\": [\n            \"symbol-5dbbb5af238c\"\n          ]\n        },\n        {\n          \"content\": \"export const isSuccessResult = (\\n  result: CollectProjectsResult\\n): result is CollectProjectsSuccessResult => !('error' in result);\",\n          \"end_line\": 90,\n          \"path\": \"code/lib/cli-storybook/src/util.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-b2051b981240\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-9591a6bc8fe7\",\n          \"start_line\": 88,\n          \"symbol_ids\": [\n            \"symbol-b5d856a2ed92\"\n          ]\n        },\n        {\n          \"content\": \"export const isErrorResult = (\\n  result: CollectProjectsResult\\n): result is CollectProjectsErrorResult => 'error' in result;\",\n          \"end_line\": 100,\n          \"path\": \"code/lib/cli-storybook/src/util.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-7ecbfa33c544\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-9591a6bc8fe7\",\n          \"start_line\": 98,\n          \"symbol_ids\": [\n            \"symbol-c99b97ff8cb4\"\n          ]\n        },\n        {\n          \"content\": \"const isCanaryVersion = (version: string): boolean =>\\n  version.startsWith('0.0.0') || version.startsWith('portal:') || version.startsWith('workspace:');\",\n          \"end_line\": 143,\n          \"path\": \"code/lib/cli-storybook/src/util.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-2ae892450fcd\",\n          \"snippet_kind\": \"symbol\",\n          \"s