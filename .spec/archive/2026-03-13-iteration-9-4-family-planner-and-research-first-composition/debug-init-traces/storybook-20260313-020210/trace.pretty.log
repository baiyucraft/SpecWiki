e Source block deprecations,\\n      // we should restore this optimizationand make the Source block\\n      // smarter about understanding when its args change.\\n      //\\n      // See https://github.com/storybookjs/storybook/pull/22807\",\n            \"end_line\": 68,\n            \"path\": \"code/addons/docs/src/blocks/blocks/SourceContainer.tsx\",\n            \"score\": 70,\n            \"snippet_id\": \"snippet-021704ab8188\",\n            \"snippet_kind\": \"process-step\",\n            \"source_id\": \"source-8933b0cb2cce\",\n            \"start_line\": 45,\n            \"symbol_ids\": [\n              \"symbol-71ed5fa1a258\"\n            ]\n          },\n          {\n            \"content\": \"handleAddValueAdd({ key, newValue }: any) {\\n    const { data, keyPath = [], nextDeep: deep } = this.state;\\n    const { beforeAddAction, logger } = this.props;\\n\\n    (beforeAddAction || Promise.resolve.bind(Promise))(key, keyPath, deep, newValue)\\n      .then(() => {\\n        // Update data\\n        data[key] = newValue;\\n        this.setState({\\n          data,\\n        });\\n        // Cancel add to close\\n        this.handleAddValueCancel();\\n        // Spread new update\\n        const { onUpdate, onDeltaUpdate } = this.props;\\n        onUpdate(keyPath[keyPath.length - 1], data);\\n        // Spread delta update\\n        onDeltaUpdate({\\n          type: deltaTypes.ADD_DELTA_TYPE,\\n          keyPath,\\n          deep,\\n          key,\\n          newValue,\\n        });\",\n            \"end_line\": 1096,\n            \"path\": \"code/addons/docs/src/blocks/controls/react-editable-json-tree/JsonNodes.tsx\",\n            \"score\": 70,\n            \"snippet_id\": \"snippet-29df99ba1d10\",\n            \"snippet_kind\": \"process-step\",\n            \"source_id\": \"source-5512d4e0d7de\",\n            \"start_line\": 1073,\n            \"symbol_ids\": [\n              \"symbol-76f1f454d43d\"\n            ]\n          },\n          {\n          