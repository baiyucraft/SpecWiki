\n    [CLEAR_ID]: () => {\\n      setCount((c) => ({ ...c, count: 0 }));\\n    },\\n  });\\n\\n  const suffix =\\n    count === 0 ? null : (\\n      <Badge compact status={selectedPanel === PANEL_ID ? 'active' : 'neutral'}>\\n        {count}\\n      </Badge>\\n    );\",\"end_line\":33,\"path\":\"code/core/src/actions/components/Title.tsx\",\"score\":100,\"snippet_id\":\"snippet-73405588f46f\",\"snippet_kind\":\"symbol\",\"source_id\":\"source-79e9b153d97c\",\"start_line\":10,\"symbol_ids\":[\"symbol-671e5c5ae745\"]},{\"content\":\"export const ViewportTool = () => {\\n  const { name, value, isDefault, isLocked, options: viewportMap, reset, select } = useViewport();\\n\\n  const options = useMemo(\\n    () =>\\n      Object.entries(viewportMap).map(([k, value]) => ({\\n        value: k,\\n        title: value.name,\\n        icon: iconsMap[value.type!],\\n        right: (\\n          <Dimensions>\\n            <span>{value.styles.width.replace('px', '')}</span>\\n            <span>&times;</span>\\n            <span>{value.styles.height.replace('px', '')}</span>\\n          </Dimensions>\\n        ),\\n      })),\\n    [viewportMap]\\n  );\\n\\n  return (\\n    <Select\\n      resetLabel=\\\"Reset viewport\\\"\\n      onReset={reset}\",\"end_line\":45,\"path\":\"code/core/src/viewport/components/Tool.tsx\",\"score\":100,\"snippet_id\":\"snippet-b7aff33f64f0\",\"snippet_kind\":\"symbol\",\"source_id\":\"source-eee495f6d1ef\",\"start_line\":22,\"symbol_ids\":[\"symbol-cccebe1b83f8\"]},{\"content\":\"export function Title() {\\n  const api = useStorybookApi();\\n  const selectedPanel = api.getSelectedPanel();\\n  const rows = useArgTypes();\\n  const controlsCount = Object.values(rows).filter(\\n    (argType) => argType?.control && !argType?.table?.disable\\n  ).length;\\n  const suffix =\\n    controlsCount === 0 ? null : (\\n      <Badge compact status={selectedPanel === ADDON_ID ? 'active' : 'neutral'}>\\n        {controlsCount}\\n      </Badge>\\n    );\\n\\n  return (\\n    <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>\\n      <span>Controls</span>\\n      {suffix}\\n    </div>\\n  );\\n}\",\"end_line\":29,\"path\":\"code/core/src/controls/components/Title.tsx\",\"score\":100,\"snippet_id\":\"snippet-2fb8f42ba40d\",\"snippet_kind\":\"symbol\",\"source_id\":\"source-0a03775a6280\",\"start_line\":9,\"symbol_ids\":[\"symbol-bd78c11ebe0d\"]}]}",
