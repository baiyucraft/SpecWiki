st value: string = stringifyObject(object[key], level + 1);\\n        return `\\\\n${indent}  ${key}: ${value}`;\\n      });\\n      objectString = objectStrings.join(',');\\n    }\",\n          \"end_line\": 29,\n          \"path\": \"code/presets/server-webpack/src/lib/compiler/stringifier.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-4e3bb83f4c39\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-90d1c5bc4504\",\n          \"start_line\": 6,\n          \"symbol_ids\": [\n            \"symbol-02b459ccd5e5\"\n          ]\n        },\n        {\n          \"content\": \"export function stringifyImports(imports: Record<string, string[]>): string {\\n  if (Object.keys(imports).length === 0) {\\n    return '';\\n  }\\n  return Object.entries(imports)\\n    .map(([module, names]) => `import { ${names.sort().join(', ')} } from '${module}';\\\\n`)\\n    .join('');\\n}\",\n          \"end_line\": 50,\n          \"path\": \"code/presets/server-webpack/src/lib/compiler/stringifier.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-8c6e8d21a926\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-90d1c5bc4504\",\n          \"start_line\": 43,\n          \"symbol_ids\": [\n            \"symbol-300c04bf8cd5\"\n          ]\n        },\n        {\n          \"content\": \"export function stringifyDecorators(decorators: string[] | undefined): string {\\n  return decorators && decorators.length > 0\\n    ? `\\\\n  decorators: [\\\\n    ${decorators.join(',\\\\n    ')}\\\\n  ],`\\n    : '';\\n}\",\n          \"end_line\": 56,\n          \"path\": \"code/presets/server-webpack/src/lib/compiler/stringifier.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-0f3c3c7b64fe\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-90d1c5bc4504\",\n          \"start_line\": 52,\n          \"symbol_ids\": [\n            \"symbol-8dd5f971342b\"\n          ]\n        },\n        {\n          \"content\": \"export function stringifyDefault(section: StorybookSection): string {\\n  const { title, imports, decorators, stories, ...options } = section;\\n\\n  const decoratorsString = stringifyDecorators(decorators);\\n\\n  const optionsString = stringifyObject(options, 0, true);\\n\\n  return dedent`\\n  export default {\\n    title: ${JSON.stringify(title)},${decoratorsString}${optionsString}\\n  };\\n\\n  `;\\n}\",\n          \"end_line\": 71,\n          \"path\": \"code/presets/server-webpack/src/lib/compiler/stringifier.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-d2f84a5fc312\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-90d1c5bc4504\",\n          \"start_line\": 58,\n          \"symbol_ids\": [\n            \"symbol-f6c2dbe178c6\"\n          ]\n        },\n        {\n          \"content\": \"export function stringifyStory(story: StorybookStory): string {\\n  const { name, ...options } = story;\\n  const storyId = identifier(name);\\n\\n  const exportedStory = { name, ...options };\\n\\n  const storyStrings = [`export const ${storyId} = ${stringifyObject(exportedStory)};`, ''];\\n\\n  return storyStrings.join('\\\\n');\\n}\",\n          \"end_line\": 82,\n          \"path\": \"code/presets/server-webpack/src/lib/compiler/stringifier.ts\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-56b63c073016\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-90d1c5bc4504\",\n          \"start_line\": 73,\n          \"symbol_ids\": [\n            \"symbol-91c79e813ef8\"\n          ]\n        },\n        {\n          \"content\": \"export function stringifySection(section: StorybookSection): string {\\n  const sectionString = [\\n    stringifyImports(section.imports),\\n    stringifyDefault(section),\\n    ...section.stories.map((story) => stringifyStory(story)),\\n  ].join('\\\\n');\\n\\n  return sectionString;\\n}\",\n          \"