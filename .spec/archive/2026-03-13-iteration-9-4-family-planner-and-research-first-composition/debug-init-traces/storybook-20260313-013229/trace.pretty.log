          },
          {
            "content": "function checkName(plugin: PluginOption, names: string[]) {\n  return (\n    plugin !== null && typeof plugin === 'object' && 'name' in plugin && names.includes(plugin.name)\n  );\n}",
            "end_line": 7,
            "path": "code/builders/builder-vite/src/utils/has-vite-plugins.ts",
