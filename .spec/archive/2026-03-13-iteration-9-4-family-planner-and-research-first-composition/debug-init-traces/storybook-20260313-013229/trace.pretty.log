          "content": "{\"snippets\":[{\"content\":\"// Builder-internal plugins (used by vite-config.ts to assemble the builder's plugin stack)\\nexport { storybookOptimizeDepsPlugin } from './storybook-optimize-deps-plugin';\\nexport { storybookEntryPlugin } from './storybook-entry-plugin';\\nexport { pluginWebpackStats } from './webpack-stats-plugin';\\nexport type { WebpackStatsPlugin } from './webpack-stats-plugin';\\n\\n// Lower-level plugins re-exported for internal use and tests\\nexport { injectExportOrderPlugin } from './inject-export-order-plugin';\\nexport { stripStoryHMRBoundary } from './strip-story-hmr-boundaries';\\nexport { codeGeneratorPlugin } from './code-generator-plugin';\\nexport { csfPlugin } from './csf-plugin';\\nexport { storybookExternalGlobalsPlugin } from './storybook-external-globals-plugin';\",\"end_line\":12,\"path\":\"code/builders/builder-vite/src/plugins/index.ts\",\"score\":0,\"snippet_id\":\"snippet-aaf27fd8f741\",\"snippet_kind\":\"tool-file-window\",\"source_id\":\"source-072256fa5950\",\"start_line\":1,\"symbol_ids\":[]},{\"content\":\"export async function csfPlugin(config: Options): Promise<Plugin> {\\n  const { presets } = config;\\n\\n  const addons = await presets.apply('addons', []);\\n  const docsOptions =\\n    // @ts-expect-error - not sure what type to use here\\n    addons.find((a) => [a, a.name].includes('@storybook/addon-docs'))?.options ?? {};\\n\\n  const enrichCsf = await presets.apply('experimental_enrichCsf');\\n\\n  // TODO: looks like unplugin can return an array of plugins\\n  return vite({\\n    ...docsOptions?.csfPluginOptions,\\n    enrichCsf,\\n  }) as Plugin;\\n}\",\"end_line\":22,\"path\":\"code/builders/builder-vite/src/plugins/csf-plugin.ts\",\"score\":100,\"snippet_id\":\"snippet-833058c734e5\",\"snippet_kind\":\"symbol\",\"source_id\":\"source-5fc6824db75a\",\"start_line\":7,\"symbol_ids\":[\"symbol-a35ae73d2f19\"]},{\"content\":\"function checkName(plugin: PluginOption, names: string[]) {\\n  return (\\n    plugin !== null && typeof plugin === 'object' && 'name' in plugin && names.includes(plugin.name)\\n  );\\n}\",\"end_line\":7,\"path\":\"code/builders/builder-vite/src/utils/has-vite-plugins.ts\",\"score\":100,\"snippet_id\":\"snippet-8b25d7dfba6f\",\"snippet_kind\":\"symbol\",\"source_id\":\"source-1ea5909b7890\",\"start_line\":3,\"symbol_ids\":[\"symbol-545d01d774e9\"]},{\"content\":\"export function getCleanId(id: string) {\\n  return id\\n    .replace(/^.*\\\\/deps\\\\//, '') // Remove everything up to and including /deps/\\n    .replace(/\\\\.js.*$/, '') // Remove .js and anything after (query params)\\n    .replace(/_/g, '/');\\n}\",\"end_line\":14,\"path\":\"code/builders/builder-vite/src/plugins/vite-mock/utils.ts\",\"score\":100,\"snippet_id\":\"snippet-18dc742b9c48\",\"snippet_kind\":\"symbol\",\"source_id\":\"source-cb0525e0243c\",\"start_line\":9,\"symbol_ids\":[\"symbol-367e1c3dfe8a\"]}]}",
