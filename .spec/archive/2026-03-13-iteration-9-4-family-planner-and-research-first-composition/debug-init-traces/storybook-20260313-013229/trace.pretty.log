            "content": "export function Title() {\n  const api = useStorybookApi();\n  const selectedPanel = api.getSelectedPanel();\n  const [{ count }, setCount] = useAddonState(ADDON_ID, { count: 0 });\n\n  useChannel({\n    [EVENT_ID]: () => {\n      setCount((c) => ({ ...c, count: c.count + 1 }));\n    },\n    [STORY_CHANGED]: () => {\n      setCount((c) => ({ ...c, count: 0 }));\n    },\n    [CLEAR_ID]: () => {\n      setCount((c) => ({ ...c, count: 0 }));\n    },\n  });\n\n  const suffix =\n    count === 0 ? null : (\n      <Badge compact status={selectedPanel === PANEL_ID ? 'active' : 'neutral'}>\n        {count}\n      </Badge>\n    );",
            "end_line": 33,
            "path": "code/core/src/actions/components/Title.tsx",
