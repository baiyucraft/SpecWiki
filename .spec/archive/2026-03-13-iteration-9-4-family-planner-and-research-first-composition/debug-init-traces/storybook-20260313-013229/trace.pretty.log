          },
          {
            "content": "export function stringifyDefault(section: StorybookSection): string {\n  const { title, imports, decorators, stories, ...options } = section;\n\n  const decoratorsString = stringifyDecorators(decorators);\n\n  const optionsString = stringifyObject(options, 0, true);\n\n  return dedent`\n  export default {\n    title: ${JSON.stringify(title)},${decoratorsString}${optionsString}\n  };\n\n  `;\n}",
            "end_line": 71,
            "path": "code/presets/server-webpack/src/lib/compiler/stringifier.ts",
            "score": 100,
            "snippet_id": "snippet-d2f84a5fc312",
            "snippet_kind": "symbol",
