ml, options);\\n    },\",\n            \"end_line\": 94,\n            \"path\": \"code/builders/builder-vite/src/plugins/code-generator-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-2b7893f7b2dc\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-1379db2c3f3d\",\n            \"start_line\": 89,\n            \"symbol_ids\": [\n              \"symbol-24cc2f2f1b16\"\n            ]\n          },\n          {\n            \"content\": \"config(config) {\\n        // If there is NO allow list then Vite allows anything in the root directory.\\n        // If there IS an allow list then Vite only allows the listed directories.\\n        // We add the storybook config directory only if there's already an allow list,\\n        // to avoid disallowing the root unless it's already restricted.\\n        if (config?.server?.fs?.allow) {\\n          config.server.fs.allow.push(options.configDir);\\n        }\\n      },\",\n            \"end_line\": 59,\n            \"path\": \"code/builders/builder-vite/src/plugins/storybook-config-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-c66c2967925f\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-45544b77598d\",\n            \"start_line\": 51,\n            \"symbol_ids\": [\n              \"symbol-da93be7969f9\"\n            ]\n          },\n          {\n            \"content\": \"export async function storybookEntryPlugin(options: Options): Promise<Plugin[]> {\\n  return [\\n    // Pre-enforcement: handles virtual module resolution and loading (must run first)\\n    codeGeneratorPlugin(options),\\n    // Post-enforcement: injects __namedExportsOrder after TypeScript transpilation\\n    await injectExportOrderPlugin(),\\n    // Post-enforcement: removes import.meta.hot.accept() from story files\\n    await stripStoryHMRBoundary(),\\n  ];\\n}\",\n            \"end_line\": 22,\n            \"path\": \"code/bu