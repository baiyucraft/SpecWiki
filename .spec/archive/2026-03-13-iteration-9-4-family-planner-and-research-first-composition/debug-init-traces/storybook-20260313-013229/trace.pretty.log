s> = (props = { __forceInitialArgs: false, __primary: false }) => {\\n  const context = useContext(DocsContext);\\n  const storyId = getStoryId(props, context);\\n  const story = useStory(storyId, context);\\n\\n  if (!story) {\\n    return <StorySkeleton />;\\n  }\\n\\n  const storyProps = getStoryProps(props, story, context);\\n  if (!storyProps) {\\n    return null;\\n  }\\n\\n  return <PureStory {...storyProps} />;\\n};\",\n          \"end_line\": 131,\n          \"path\": \"code/addons/docs/src/blocks/blocks/Story.tsx\",\n          \"score\": 100,\n          \"snippet_id\": \"snippet-67fe29ec1bf7\",\n          \"snippet_kind\": \"symbol\",\n          \"source_id\": \"source-4f47466aed83\",\n          \"start_line\": 116,\n          \"symbol_ids\": [\n            \"symbol-6a1ee51884dd\"\n          ]\n        },\n        {\n          \"content\": \"interface TabsProps {\\n  tabs: {\\n    label: React.ReactElement;\\n    panel: React.ReactElement;\\n    items: Result[];\\n    type: RuleType;\\n  }[];\\n}\",\n          \"end_line\": 35,\n          \"path\": \"code/addons/a11y/src/components/Tabs.tsx\",\n          \"score\": 80,\n          \"snippet_id\": \"snippet-2c7bda26ac53\",\n          \"snippet_kind\": \"key-source\",\n          \"source_id\": \"source-c9d030d89fb5\",\n          \"start_line\": 28,\n          \"symbol_ids\": [\n            \"symbol-92c799acdf36\"\n          ]\n        }\n      ],\n      \"title\": \"addons能力：界面组成\",\n      \"topic_key\": \"module-8d6dc973c6b0-component\",\n      \"topic_kind\": \"module-capability\",\n      \"type_surfaces\": []\n    }\n  },\n  \"input_hash\": \"4f3a945dcd22ebd007186c2e15aab3974a7d66a4ed4f89f5e5eee3d5db32571f\",\n  \"instruction\": \"页面类型：topic\\n页面标题：addons能力：界面组成\\n页面作用域：topic:module-capability:module-8d6dc973c6b0-component\\nchild rollups 数量：0\\nrepo dossier：false\\nmodule dossiers 数量：1\\ntopic dossier：true\\nfamily dossier：false\\nevidence groups 数量：1\\ndiagram inputs 数量：0\\n允许的 section 槽位：topic-intro (主题