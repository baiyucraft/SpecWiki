              "symbol-300c04bf8cd5"
            ]
          },
          {
            "content": "export function stringifyDecorators(decorators: string[] | undefined): string {\n  return decorators && decorators.length > 0\n    ? `\\n  decorators: [\\n    ${decorators.join(',\\n    ')}\\n  ],`\n    : '';\n}",
            "end_line": 56,
            "path": "code/presets/server-webpack/src/lib/compiler/stringifier.ts",
            "score": 100,
