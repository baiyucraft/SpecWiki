            "content": "export function getCleanId(id: string) {\n  return id\n    .replace(/^.*\\/deps\\//, '') // Remove everything up to and including /deps/\n    .replace(/\\.js.*$/, '') // Remove .js and anything after (query params)\n    .replace(/_/g, '/');\n}",
