          },
          {
            "content": "export function stringifySection(section: StorybookSection): string {\n  const sectionString = [\n    stringifyImports(section.imports),\n    stringifyDefault(section),\n    ...section.stories.map((story) => stringifyStory(story)),\n  ].join('\\n');\n\n  return sectionString;\n}",
