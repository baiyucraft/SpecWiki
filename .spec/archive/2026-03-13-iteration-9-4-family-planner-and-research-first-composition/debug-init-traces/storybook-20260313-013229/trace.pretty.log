eId(SB_VIRTUAL_FILES.VIRTUAL_STORIES_FILE)\\n        );\\n      });\\n    },\",\n            \"end_line\": 38,\n            \"path\": \"code/builders/builder-vite/src/plugins/code-generator-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-13b2208addb6\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-1379db2c3f3d\",\n            \"start_line\": 29,\n            \"symbol_ids\": [\n              \"symbol-0cf1c953da24\"\n            ]\n          },\n          {\n            \"content\": \"configResolved(config) {\\n      iframeId = `${config.root}/iframe.html`;\\n    },\",\n            \"end_line\": 56,\n            \"path\": \"code/builders/builder-vite/src/plugins/code-generator-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-25e3683185c3\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-1379db2c3f3d\",\n            \"start_line\": 54,\n            \"symbol_ids\": [\n              \"symbol-c154580cbb47\"\n            ]\n          },\n          {\n            \"content\": \"resolveId(source) {\\n      if (SB_VIRTUAL_FILE_IDS.includes(source)) {\\n        return getResolvedVirtualModuleId(source);\\n      }\\n      if (source === iframePath) {\\n        return iframeId;\\n      }\\n\\n      return undefined;\\n    },\",\n            \"end_line\": 66,\n            \"path\": \"code/builders/builder-vite/src/plugins/code-generator-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-d3a4a33d5731\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-1379db2c3f3d\",\n            \"start_line\": 57,\n            \"symbol_ids\": [\n              \"symbol-ebdad46c170f\"\n            ]\n          },\n          {\n            \"content\": \"async transformIndexHtml(html, ctx) {\\n      if (ctx.path !== '/iframe.html') {\\n        return undefined;\\n      }\\n      return transformIframeHtml(html, options);\\n    },\",\n            \"end_line\": 94,\n            \"path\": \"code/builders/builder-vite/src/plugins/code-generator-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-2b7893f7b2dc\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-1379db2c3f3d\",\n            \"start_line\": 89,\n            \"symbol_ids\": [\n              \"symbol-24cc2f2f1b16\"\n            ]\n          },\n          {\n            \"content\": \"config(config) {\\n        // If there is NO allow list then Vite allows anything in the root directory.\\n        // If there IS an allow list then Vite only allows the listed directories.\\n        // We add the storybook config directory only if there's already an allow list,\\n        // to avoid disallowing the root unless it's already restricted.\\n        if (config?.server?.fs?.allow) {\\n          config.server.fs.allow.push(options.configDir);\\n        }\\n      },\",\n            \"end_line\": 59,\n            \"path\": \"code/builders/builder-vite/src/plugins/storybook-config-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-c66c2967925f\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-45544b77598d\",\n            \"start_line\": 51,\n            \"symbol_ids\": [\n              \"symbol-da93be7969f9\"\n            ]\n          },\n          {\n            \"content\": \"export async function storybookEntryPlugin(options: Options): Promise<Plugin[]> {\\n  return [\\n    // Pre-enforcement: handles virtual module resolution and loading (must run first)\\n    codeGeneratorPlugin(options),\\n    // Post-enforcement: injects __namedExportsOrder after TypeScript transpilation\\n    await injectExportOrderPlugin(),\\n    // Post-enforcement: removes import.meta.hot.accept() from story files\\n    await stripStoryHMRBoundary(),\\n  ];\\n}\",\n            \"end_line\": 22,\n            \"path\": \"code/builders/builder-vite/src/plugins/storybook-entry-plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-8c0f272d699c\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-3738c3021b56\",\n            \"start_line\": 13,\n            \"symbol_ids\": [\n              \"symbol-8511e437983c\"\n            ]\n          },\n          {\n            \"content\": \"configResolved(config) {\\n        viteConfig = config;\\n      },\",\n            \"end_line\": 56,\n            \"path\": \"code/builders/builder-vite/src/plugins/vite-mock/plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-b8d3e8cbcee4\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-07f594093b39\",\n            \"start_line\": 54,\n            \"symbol_ids\": [\n              \"symbol-6f07cc60d48e\"\n            ]\n          },\n          {\n            \"content\": \"buildStart() {\\n        mockCalls = extractMockCalls(options, babelParser, viteConfig.root, findMockRedirect);\\n      },\",\n            \"end_line\": 60,\n            \"path\": \"code/builders/builder-vite/src/plugins/vite-mock/plugin.ts\",\n            \"score\": 100,\n            \"snippet_id\": \"snippet-763283b6e4c7\",\n            \"snippet_kind\": \"symbol\",\n            \"source_id\": \"source-07f594093b39\",\n            \"start_line\": 58,\n            \"symbol_ids\": [\n              \"symbol-1932462f51e1\"\n            ]\n          },\n          {\n            \"content\": \"export function codeGeneratorPlugin(options: Options) {\\n  const iframePath = fileURLToPath(importMetaResolve('@storybook/builder-vite/input/iframe.html'));\\n  let iframeId: string;\\n  const storyIndexGeneratorPromise: Promise<StoryIndexGenerator> =\\n    options.presets.apply<StoryIndexGenerator>('storyIndexGenerator');\\n\\n  return {\\n    name: 'storybook:code-generator-plugin',\\n    enforce: 'pre',\\n    async configureServer(server) {\\n      (await storyIndexGeneratorPromise).onInvalidated(() => {\\n        // TODO: this is only necessary when new files are added.\\n        // Changes and removals are already watched and handled by Vite, so they actually trigger a double HMR event right now.\\n        server.watcher.emit(\\n          'change',\\n          getResolvedVirtualModuleId(SB_VIRTUAL_FILES.VIRTUAL_STORIES_FILE)\\n        );\\n      });\\n    },\\n    config(config, { command }) {\\n      // If we are building the static distribution, add iframe.html as an entry.\\n      // In development mode, it's not an entry - instead, we use a middleware\\n      // to serve iframe.html. The reason is that Vite's dev server (at the time of writing)\\n      // does not support virtual files as entry points.\",\n            \"end_line\": 43,\n            \"path\": \"code/builders/builder-vite/src/plugins/code-generator-plugin.ts\",\n            \"score\": 80,\n            \"snippet_id\": \"snippet-cb353ca120a0\",\n            \"snippet_kind\": \"key-source\",\n            \"source_id\": \"source-1379db2c3f3d\",\n            \"start_line\": 20,\n            \"symbol_ids\": [\n              \"symbol-2b26413209e1\"\n            ]\n          },\n          {\n            \"content\": \"async configureServer(server) {\\n      (await storyIndexGeneratorPromise).onInvalidated(() => {\\n        // TODO: this is only necessary when new files are added.\\n        // Changes and removals are already watched and handled by Vite, so they actually trigger a double HMR event right now.\\n        server.watcher.emit(\\n          'change',\\n          getResolvedVirtualModuleId(SB_VIRTUAL_FILES.VIRTUAL_STORIES_FILE)\\n        );\\n      });\\n    },\",\n            \"end_line\": 38,\n            \"path\": \"code/builders/builder-vite/src/plugins/code-generator-plugin.ts\",\n            \"score\": 80,\n            \"snippet_id\": \"snippet-0d08f8dd19f7\",\n            \"snippet_kind\": \"key-source\",\n            \"sou