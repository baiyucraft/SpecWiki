\n        \"items\": {\n          \"type\": \"string\"\n        },\n        \"type\": \"array\"\n      },\n      \"open_questions\": {\n        \"items\": {\n          \"type\": \"string\"\n        },\n        \"type\": \"array\"\n      },\n      \"summary\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"summary\",\n      \"key_points\",\n      \"evidence_rollup\",\n      \"diagram_rollup\",\n      \"open_questions\"\n    ],\n    \"type\": \"object\"\n  },\n  \"session\": null\n}\n请只返回符合 response_schema 的 JSON 对象。",
