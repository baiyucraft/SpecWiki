dule_dossiers\": [],\n    \"page_id\": \"page-2ec258702489\",\n    \"page_type\": \"topic\",\n    \"scope\": \"topic:process:process-handler-flow\",\n    \"summary_inputs\": [\n      \"主题摘要：Handler flow: Handler -> chain\",\n      \"关键源码：_examples/custom-handler/main.go\",\n      \"关键源码：_examples/custom-method/main.go\",\n      \"关键源码：_examples/fileserver/main.go\",\n      \"关键源码：_examples/graceful/main.go\",\n      \"关键源码：_examples/hello-world/main.go\",\n      \"关键源码：_examples/limits/main.go\"\n    ],\n    \"title\": \"流程主题：Handler flow\",\n    \"topic_dossier\": {\n      \"child_page_rollup\": [],\n      \"diagram_rollup\": [],\n      \"dossier_id\": \"topic-dossier-79adef2ea738\",\n      \"evidence_rollup\": [\n        {\n          \"group_key\": \"evidence-group-976d686d3a7d\",\n          \"items\": [\n            {\n              \"end_line\": 0,\n              \"note\": \"\",\n              \"path\": \"_examples/custom-handler/main.go\",\n              \"source_id\": \"source-14e34ed85da0\",\n              \"start_line\": 0\n            },\n            {\n              \"end_line\": 0,\n              \"note\": \"\",\n              \"path\": \"_examples/custom-method/main.go\",\n              \"source_id\": \"source-e4376e094763\",\n              \"start_line\": 0\n            },\n            {\n              \"end_line\": 0,\n              \"note\": \"\",\n              \"path\": \"_examples/fileserver/main.go\",\n              \"source_id\": \"source-5245e4eb3fdd\",\n              \"start_line\": 0\n            },\n            {\n              \"end_line\": 0,\n              \"note\": \"\",\n              \"path\": \"_examples/graceful/main.go\",\n              \"source_id\": \"source-a4e32618cf59\",\n              \"start_line\": 0\n            },\n            {\n              \"end_line\": 0,\n              \"note\": \"\",\n              \"path\": \"_examples/hello-world/main.go\",\n              \"source_id\": \"source-d045dfa4eadd\",\n              \"sta